{
  "name": "worklab",
  "version": "0.1.0",
  "description": "Local AI agent orchestration tool",
  "type": "module",
  "private": true,
  "bin": {
    "worklab": "./src/cli/index.js"
  },
  "scripts": {
    "start": "node src/cli/index.js start",
    "dev": "node src/cli/index.js start",
    "build:ui": "vite build --config src/ui/vite.config.js",
