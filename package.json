    "ai": "^6.0.168",
    "ai-sdk-ollama": "^3.8.3",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "nanoid": "^5.0.9",
    "ollama-ai-provider-v2": "^3.5.0",
    "picomatch": "^4.0.4",
    "pino": "^9.5.0",
    "preact": "^10.25.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.1",
