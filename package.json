{
  "name": "@worklab-ai/worklab",
  "version": "0.1.0",
  "description": "Local AI agent orchestration tool",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/worklab.git"
  },
  "bugs": {
    "url": "https://github.com/robertsreberski/worklab/issues"
  },
  "homepage": "https://github.com/robertsreberski/worklab#readme",
  "keywords": [
    "ai",
    "agents",
    "automation",
    "cli",
    "local-first",
    "orchestration",
    "worklab"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "data-template/",
    "skills/worklab/",
    "src/api/",
    "src/cli/",
    "src/core/",
    "src/coordinator/",
    "src/coordinator.js",
    "src/integrations/",
    "src/mcp/",
    "src/ui/dist/",
    "src/worker/",
    "src/worker.js"
  ],
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "bin": {
    "worklab": "./src/cli/index.js"
  },
  "scripts": {
    "start": "npm run build:ui && node src/cli/index.js serve",
    "dev": "node src/cli/index.js serve",
    "dev:api": "node src/cli/index.js serve",
    "dev:ui": "vite --config src/ui/vite.config.js",
    "install:worklab": "npm link",
    "build:ui": "vite build --config src/ui/vite.config.js",
    "test": "vitest run",
    "test:e2e:ollama": "npm run build:ui && playwright test --config playwright.config.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src packages",
    "lint:boundaries": "eslint src packages --rule '{\"no-restricted-imports\":\"warn\"}'",
    "lint:size": "node scripts/guard-file-size.js",
    "pack:check": "npm pack --dry-run --json | node scripts/validate-npm-pack.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@slack/bolt": "^4.7.1",
    "@worklab-ai/agent-runtime": "^0.1.0",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jszip": "^3.10.1",
    "nanoid": "^5.0.9",
    "picomatch": "^4.0.4",
    "pino": "^9.5.0",
    "preact": "^10.25.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@preact/preset-vite": "^2.9.1",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "supertest": "^7.0.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
