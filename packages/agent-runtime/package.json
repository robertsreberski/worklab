{
  "name": "@worklab-ai/agent-runtime",
  "version": "0.1.3",
  "description": "Agent runtime supporting Claude SDK, Claude CLI, Codex CLI, and PI SDK out of the box",
  "type": "module",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robertsreberski/worklab.git",
    "directory": "packages/agent-runtime"
  },
  "bugs": {
    "url": "https://github.com/robertsreberski/worklab/issues"
  },
  "homepage": "https://github.com/robertsreberski/worklab/tree/main/packages/agent-runtime#readme",
  "keywords": [
    "ai",
    "agents",
    "runtime",
    "worklab"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./src/index.js",
    "./ai": "./src/ai/index.js",
    "./agent": "./src/agent/index.js",
    "./ai/*": "./src/ai/*",
    "./agent/*": "./src/agent/*"
  },
  "main": "./src/index.js",
  "files": [
    "src/**/*.js",
    "!src/__tests__/**",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@mariozechner/pi-agent-core": "^0.73.1",
    "@mariozechner/pi-ai": "^0.73.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^4.3.6"
  }
}
