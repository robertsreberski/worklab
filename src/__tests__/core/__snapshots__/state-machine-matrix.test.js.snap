// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`nextStage matrix snapshot > freezes children completion / blocking 1`] = `
[
  [
    "awaiting_children|children_completed",
    "awaiting_children",
    {
      "sideEffects": [
        {
          "type": "clear_error_text",
        },
        {
          "type": "clear_pending_actions",
        },
        {
          "type": "clear_blocking_issues",
        },
        {
          "reason": "required children completed",
          "type": "set_stage_reason",
        },
      ],
      "stage": "execute",
    },
  ],
  [
    "execute|children_completed",
    "execute",
    {
      "sideEffects": [
        {
          "message": "cannot resume children from execute",
          "type": "error",
        },
      ],
      "stage": "execute",
    },
  ],
  [
    "awaiting_children|child_blocked",
    "awaiting_children",
    {
      "sideEffects": [
        {
          "type": "clear_pending_actions",
        },
        {
          "message": "blocker",
          "type": "set_error_text",
        },
        {
          "reason": "required_child_blocked",
          "type": "set_stage_reason",
        },
        {
          "blockingIssues": [
            "blocker",
          ],
          "type": "set_blocking_issues",
        },
      ],
      "stage": "blocked",
    },
  ],
  [
    "execute|child_blocked",
    "execute",
    {
      "sideEffects": [],
      "stage": "execute",
    },
  ],
]
`;

exports[`nextStage matrix snapshot > freezes failure / cancel / abandon at threshold and below 1`] = `
[
  [
    "execute|run_failed|0",
    "execute",
    {
      "sideEffects": [
        {
          "message": "boom",
          "type": "post_error_comment",
        },
        {
          "message": "boom",
          "type": "set_error_text",
        },
        {
          "reason": "spawn",
          "type": "set_stage_reason",
        },
        {
          "count": 1,
          "type": "set_failure_count",
        },
        {
          "kind": "spawn",
          "type": "set_last_failure_kind",
        },
      ],
      "stage": "execute",
    },
  ],
  [
    "execute|run_failed|2",
    "execute",
    {
      "sideEffects": [
        {
          "message": "boom",
          "type": "post_error_comment",
        },
        {
          "message": "boom",
          "type": "set_error_text",
        },
        {
          "reason": "spawn",
          "type": "set_stage_reason",
        },
        {
          "count": 3,
          "type": "set_failure_count",
        },
        {
          "kind": "spawn",
          "type": "set_last_failure_kind",
        },
        {
          "blockingIssues": [
            "Reached max failures (3). Last error: boom",
          ],
          "type": "set_blocking_issues",
        },
      ],
      "stage": "blocked",
    },
  ],
  [
    "execute|run_cancelled|user",
    "execute",
    {
      "sideEffects": [
        {
          "type": "clear_error_text",
        },
        {
          "reason": "cancelled (user)",
          "type": "set_stage_reason",
        },
        {
          "message": "user cancelled",
          "type": "post_cancellation_comment",
        },
      ],
      "stage": "execute",
    },
  ],
  [
    "execute|run_cancelled|stale",
    "execute",
    {
      "sideEffects": [
        {
          "type": "clear_error_text",
        },
        {
          "reason": "cancelled (stale_reconcile)",
          "type": "set_stage_reason",
        },
        {
          "message": "stale",
          "type": "post_cancellation_comment",
        },
      ],
      "stage": "execute",
    },
  ],
  [
    "execute|run_cancelled|signal",
    "execute",
    {
      "sideEffects": [
        {
          "type": "clear_error_text",
        },
        {
          "reason": "cancelled (signal)",
          "type": "set_stage_reason",
        },
        {
          "message": "Run cancelled.",
          "type": "post_cancellation_comment",
        },
      ],
      "stage": "execute",
    },
  ],
  [
    "execute|run_abandoned",
    "execute",
    {
      "sideEffects": [
        {
          "message": "coordinator restarted",
          "type": "post_error_comment",
        },
        {
          "message": "coordinator restarted",
          "type": "set_error_text",
        },
        {
          "reason": "abandoned",
          "type": "set_stage_reason",
        },
        {
          "kind": "abandoned",
          "type": "set_last_failure_kind",
        },
      ],
      "stage": "execute",
    },
  ],
]
`;

